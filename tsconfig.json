{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "skipLibCheck": true,
    "types": ["@solidjs/start/env", "node"],
    "baseUrl": ".",
    "paths": { "~/*": ["./src/*"] }
  },
  "include": [
    "src",
    "vite.config.ts",
    "vitest.config.ts",
    "tests",
    "playwright.config.ts"
  ]
}
